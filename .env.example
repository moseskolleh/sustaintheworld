# Copy to .env and fill in. .env is gitignored — never commit the real key.
#   cp .env.example .env
#   npm run voice -- --clone path/to/your-voice-sample.mp3

# Required. From https://fish.audio/go-api/ (dashboard → API keys).
# Used only by scripts/generate-voice.js, on your machine, at build time.
# It never reaches the browser and never runs in CI.
FISH_AUDIO_API_KEY=

# Written automatically the first time you run with --clone. After that,
# every render speaks in that voice. You can also paste an id here by hand
# if you cloned a voice on the Fish Audio website instead.
FISH_AUDIO_VOICE_ID=

# Per-call text limit, which depends on your Fish Audio plan:
#   free        500 bytes   (the default here)
#   lite/plus   15000
#   other paid  30000
# Scripts longer than this are split at sentence boundaries and the rendered
# audio is joined back into one file per section. Billing is per byte of text,
# so splitting costs nothing extra — but raising this on a paid plan renders
# each section in a single call, with no joins at all.
# FISH_AUDIO_MAX_BYTES=500

# Optional overrides.
# FISH_AUDIO_MODEL=s1          # s1, s2-pro, s2.1-pro
# FISH_AUDIO_FORMAT=mp3        # mp3 (universal) | opus (smaller, patchy Safari) | wav
# FISH_AUDIO_BITRATE=64        # mp3 only
# FISH_AUDIO_API_BASE=https://api.fish.audio
