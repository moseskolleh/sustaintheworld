# Copy to .env and fill in. .env is gitignored — never commit the real key.
#   cp .env.example .env
#   npm run voice

# Required. From https://fish.audio/go-api/ (dashboard → API keys).
FISH_AUDIO_API_KEY=

# Optional. A Fish Audio voice model id. Set this to a clone of your own
# voice and every section is narrated in it. Without it the API's default
# voice is used, which is fine for a first pass but not the point.
FISH_AUDIO_VOICE_ID=

# Optional overrides.
# FISH_AUDIO_MODEL=s1
# FISH_AUDIO_BITRATE=64
