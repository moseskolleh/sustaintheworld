node_modules/

# API key for the optional Fish Audio section renderer
# (scripts/generate-voice.js --sections). It must never be committed — it is
# read from the environment at build time. The site ships no rendered
# tracks; its one recording, Moses's introduction, needs no key at all.
.env
.env.*
!.env.example

# Output of `npm run voice:check`, which renders against the local mock
# server in WAV. Throwaway and large — the real narration ships as .mp3.
assets/audio/*.wav

# Voice auditions written by the fish-audio MCP server (.mcp.json) while
# choosing a voice. Scratch output — the only audio that ships is Moses's
# own recording, installed by `npm run voice:intro`.
.voice-auditions/

# Screenshots written by `npm run smoke -- --screens`.
.smoke/
